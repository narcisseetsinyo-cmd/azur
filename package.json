{
  "name": "azur",
  "productName": "Azur",
  "version": "1.2.0",
  "description": "Azur, ton budget mensuel personnel",
  "author": "Éternel Élégance",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/db.test.js",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:linux": "electron-builder --linux AppImage",
    "postinstall": "electron-builder install-app-deps",
    "build:cloud": "esbuild src/renderer/cloud.src.js --bundle --format=iife --target=es2020 --minify --legal-comments=none --outfile=src/renderer/cloud.js",
    "build:web": "node scripts/build-web.js",
    "test:sync": "firebase emulators:exec --only auth,firestore --project demo-azur \"node test/sync.e2e.mjs\""
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "firebase": "12.19.0",
    "playwright": "1.56.0"
  },
  "build": {
    "appId": "com.eternelelegance.azur",
    "productName": "Azur",
    "copyright": "© 2026 Éternel Élégance",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/renderer/cloud.src.js",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Azur-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Azur",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Azur-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Azur ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "narcisseetsinyo-cmd",
        "repo": "azur",
        "releaseType": "release"
      }
    ]
  },
  "azurUi": "1.2.0",
  "azurMinShell": "1.2.0"
}